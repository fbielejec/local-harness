# Copy to `.env` (same directory) on weebeastie and fill in. `.env` is gitignored — never commit it.
# docker compose reads this file automatically for ${VAR} interpolation.

# Stable JWT signing key. Generate with:  openssl rand -hex 32
WEBUI_SECRET_KEY=

# Exa web search API key (https://exa.ai). Required because WEB_SEARCH_ENGINE=exa.
EXA_API_KEY=

# DeepSeek Search API key. Used by functions/deepseek_search_filter.py; empty means that switch reports a failure.
DEEPSEEK_API_KEY=

# --- read by the install scripts only (install_function.py, install_interior_designer.py), not by compose ---
# An Open WebUI ADMIN API key (Settings → Account → API keys).
OPENWEBUI_API_KEY=
# OpenAI key for the Interior Designer (gpt-5.6-sol + gpt-image-1.5). The installer copies it into
# Open WebUI's connection settings and the render_design tool's valves. Set a spend limit on its project.
OPENAI_API_KEY=
