# Copy to `.env` (same directory) on weebeastie and fill in. `.env` is gitignored — never commit it.
# docker compose reads this file automatically for ${VAR} interpolation.

# Stable JWT signing key. Generate with:  openssl rand -hex 32
WEBUI_SECRET_KEY=

# Exa web search API key (https://exa.ai). Required because WEB_SEARCH_ENGINE=exa.
EXA_API_KEY=
