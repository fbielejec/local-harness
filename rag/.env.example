# Copy to `.env` and edit. Real env vars set in the shell override these.
# `.env` is gitignored; this file documents the keys (mirrors deploy/openwebui).

# --- Vector DB (Qdrant) ---
# Local dev: the docker-compose Qdrant. Remote: http://<weebeastie>:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ep_committee_docs

# --- Embeddings ---
# Changing this means updating dim + bumping the contract version in config.py.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Generator (OpenAI-compatible) ---
# GEN_* is project-namespaced on purpose so we never inherit an ambient
# OPENAI_API_KEY from your shell. Default = the remote Qwen llama-server over the
# SSH tunnel; swap GEN_BASE_URL to a local Ollama (http://localhost:11434/v1)
# without touching code. llama-server ignores the key, so "dummy" is fine.
GEN_BASE_URL=http://localhost:8080/v1
GEN_API_KEY=dummy
GEN_MODEL=unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:IQ4_XS

# --- Retrieval ---
TOP_K=5

# --- Corpus ---
DATA_DIR=data
